#!/usr/bin/env bash
# Started from hyprland.conf exec-once. Launches the shell layer chosen
# at the greeter: the session wrapper (nix, modules/desktop.nix) writes
# ~/.local/state/hypr-shell before starting Hyprland. Defaults to the
# classic stack if the state file is missing (e.g. non-nixbox machines).
shell=$(cat "$HOME/.local/state/hypr-shell" 2>/dev/null || echo classic)

# On nixbox, create a permanent headless output for Sunshine to capture.
# Sunshine locks to the output it sees at startup; keeping "stream" always
# present means it captures the headless display rather than the physical one.
# prep-cmd in each Sunshine app changes the resolution without recreating it.
if [ "$(hostname)" = "nixbox" ]; then
  hyprctl output create headless stream
fi

case "$shell" in
  noctalia)
    # Noctalia replaces waybar+mako+hyprpaper (and mako MUST not run:
    # it would take the DBus notification name noctalia needs).
    # Launch as a uwsm-managed unit: survives the exec-once startup
    # race (a bare fork once wedged before rendering) and logs to the
    # journal (journalctl --user -u app-noctalia-shell*).
    if command -v uwsm >/dev/null 2>&1; then
      uwsm app -- noctalia-shell &
    else
      noctalia-shell &
    fi
    ;;
  *)
    waybar &
    mako &
    hyprpaper &
    ;;
esac
