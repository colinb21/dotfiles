{
  "layer": "top",
  "position": "top",
  "height": 40,
  "margin-top": 6,
  "margin-left": 10,
  "margin-right": 10,
  "spacing": 4,

  "modules-left":   ["hyprland/workspaces", "hyprland/window"],
  "modules-center": ["clock"],
  "modules-right":  ["bluetooth", "network", "wireplumber", "cpu", "memory", "tray", "custom/power"],

  "hyprland/workspaces": {
    "format": "{id}",
    "on-click": "activate"
  },

  "hyprland/window": {
    "max-length": 60,
    "separate-outputs": true
  },

  "clock": {
    "format": "  {:%a %d %b  %H:%M}",
    "format-alt": "{:%Y-%m-%d}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
  },

  "bluetooth": {
    "format": "󰂯",
    "format-connected": "󰂱 {device_alias}",
    "format-connected-battery": "󰂱 {device_alias} {device_battery_percent}%",
    "tooltip-format-connected": "{controller_alias}\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "  {device_alias}",
    "on-click": "ghostty -e bluetoothctl"
  },

  "network": {
    "format-wifi": "󰤨 {essid} ({signalStrength}%)",
    "format-ethernet": "󰈀 {ifname}",
    "format-disconnected": "󰤭 disconnected",
    "tooltip-format-wifi": "{ipaddr}  {frequency}GHz\n↑ {bandwidthUpBytes}  ↓ {bandwidthDownBytes}",
    "tooltip-format-ethernet": "{ipaddr}",
    "on-click": "ghostty -e nmtui"
  },

  "wireplumber": {
    "format": "{icon} {volume}%",
    "format-muted": "󰖁 muted",
    "format-icons": ["󰕿", "󰖀", "󰕾"],
    "on-click": "pamixer -t",
    "on-scroll-up": "pamixer -i 2",
    "on-scroll-down": "pamixer -d 2",
    "on-click-right": "pavucontrol"
  },

  "cpu": {
    "format": "󰻠 {usage}%",
    "interval": 3,
    "tooltip": false
  },

  "memory": {
    "format": "󰍛 {used:0.1f}G",
    "tooltip-format": "RAM: {used:0.1f}G / {total:0.1f}G\nSwap: {swapUsed:0.1f}G / {swapTotal:0.1f}G"
  },

  "tray": {
    "spacing": 8
  },

  "custom/power": {
    "format": "󰐥",
    "on-click": "wlogout",
    "tooltip": false
  }
}
